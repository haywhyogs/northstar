# macOS / editors
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# Local-only: personal tracker, assistant instructions, learning notes (never published)
PROGRESS.md
CLAUDE.md
docs/learning-notes/
# Secrets and local env — never commit
.env
.env.*
!.env.example
*.pem
*.key

# Local log files
*.log

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Node
node_modules/
dist/
.vite/

# Terraform — state can contain secrets; it lives in Azure Storage, not Git
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
*.tfvars
!*.tfvars.example
# Lock files belong to root folders (bootstrap, environments), not to reusable modules
infrastructure/modules/**/.terraform.lock.hcl
override.tf
override.tf.json
*_override.tf
*_override.tf.json
