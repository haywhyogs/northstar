# LOCAL DEVELOPMENT ONLY. Copy this file to .env (Git ignores .env) and fill in the values.
# Nothing here is ever used in Azure. In Azure, the apps use passwordless Entra ID identities.

# Setting Y means YOU accept the licence terms of:
#   SQL Server (Developer edition): https://go.microsoft.com/fwlink/?LinkId=746388
#   Service Bus emulator:           https://github.com/Azure/azure-service-bus-emulator-installer/blob/main/EMULATOR_EULA.txt
ACCEPT_EULA=N

# Local-only SQL Server 'sa' (admin) password.
# Rules: at least 8 characters, using 3 of: uppercase, lowercase, digits, symbols.
# Avoid $ and quote characters (they confuse Docker Compose and the shell).
MSSQL_SA_PASSWORD=

# The local SQL Server uses a self-signed certificate; trust it ONLY here (never in Azure).
DB_TRUST_SERVER_CERTIFICATE=true

# Login password for the seeded DEMO customers (synthetic data only). Only its hash is stored in the database.
DEMO_CUSTOMER_PASSWORD=
